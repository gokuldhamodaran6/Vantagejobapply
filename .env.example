# Public (safe in the browser)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SUPABASE_URL=https://fplxzhjjribmscduypoj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Set to 1 after enabling Google sign-in in Supabase → Authentication → Providers
NEXT_PUBLIC_GOOGLE_AUTH=0

# Server secrets
# Shared secret for scheduled jobs and server-to-database writes (must match private.config in Supabase)
INGEST_SECRET=
# Optional: enables AI resume tailoring, resume import and the free-form agent answers
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Optional: payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# JSON map of plan_interval_region → Stripe price id, e.g.
# {"pro_month_std":"price_..","pro_quarter_std":"price_..","pro_month_ppp":"price_..","pro_quarter_ppp":"price_..","autopilot_month_std":"price_..","autopilot_quarter_std":"price_..","autopilot_month_ppp":"price_..","autopilot_quarter_ppp":"price_.."}
STRIPE_PRICES=
# Optional: email the admin when something stops (System health). Resend API key + where to send.
RESEND_API_KEY=
ALERT_EMAIL=
# ALERT_FROM=Vantage <alerts@your-domain>   (default: Resend's onboarding sender, which only reaches the Resend account's own email)
