{
  "manifest_version": 3,
  "name": "Vantage — Fill job applications",
  "short_name": "Vantage",
  "version": "1.1.5",
  "description": "Fills job applications on company careers sites with your profile, saved answers and a resume tailored to each job. You check it, then submit it yourself or ask Vantage to.",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fill with Vantage",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "https://vantagejobapply.onrender.com/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "launcher.js"
      ],
      "run_at": "document_idle"
    }
  ]
}